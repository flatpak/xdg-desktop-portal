<node name="/" xmlns:doc="http://www.freedesktop.org/dbus/1.0/doc.dtd">
  <!--
      org.freedesktop.impl.portal.ProxyResolver:
      @short_description: ProxyResolver portal backend interface

      This portal lets applications resolve proxy configuration from a given
      URL. This feature is already provided for you by xdg-desktop-portal;
      just use a backend supported by the GLib GProxyResolver interface.

      View the methods and properties documented in this interface for
      features you can implement.

      This documentation describes version 1 of this interface.
  -->
  <interface name="org.freedesktop.impl.portal.ProxyResolver">
    <!--
        ConfigureProxy:
        @parent_window: Identifier for the application window, see :doc:`window-identifiers`
        @options: Vardict with optional further information

        Request showing a configuration UI so the user is able to configure the system proxy.

        Supported keys in the @options vardict include:

        * ``activation_token`` (``s``)

          A token that can be used to activate the configuration window.

        * ``autoconfig_url`` (``s``)

          A URL that provides proxy configuration values.
    -->
    <method name="ConfigureProxy">
      <arg type="s" name="parent_window" direction="in" />
      <annotation name="org.qtproject.QtDBus.QtTypeName.In2" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
    </method>

    <property name="version" type="u" access="read"/>
  </interface>
</node>
