<node name="/" xmlns:doc="http://www.freedesktop.org/dbus/1.0/doc.dtd">
  <!--
      org.freedesktop.portal.ProxyResolver:
      @short_description: Portal for querying proxy information

      The ProxyResolver interface provides network proxy information to
      sandboxed applications. It is not a portal in the strict sense, since it
      does not involve user interaction. Applications are expected to use this
      interface indirectly, via a library API such as the GLib GProxyResolver
      interface.

      URIs passed to and from this portal are as described in RFC 3986. IP
      addresses described in this portal are defined according to CIDR notation.

      This documentation describes version 2 of this interface.
  -->
  <interface name="org.freedesktop.portal.ProxyResolver">
    <!--
        Lookup:
        @uri: A URI of the destination to connect to
        @proxies: List of proxy URIs

        Looks up which proxy to use to connect to @uri. The returned
        proxy URI are of the form ``protocol://[user[:password] AT host:port``.
        The protocol can be ``http``, ``rtsp``, ``socks`` or another proxying
        protocol. ``direct://`` is used when no proxy is needed.
    -->
    <method name="Lookup">
      <arg type="s" name="uri" direction="in"/>
      <arg type="as" name="proxies" direction="out"/>
    </method>
    <!--
        LookupMultiple:
        @uris: A list of URIs of the destinations to connect to
        @proxies: List of a list of proxy URIs

        Behaves similarly to :ref:`org.freedesktop.portal.ProxyResolver.Lookup`,
        but operates on multiple URIs at once. Clients should use this method
        if they batch their URI lookups or otherwise want to quickly build a
        cache of proxy results.

        If this method fails (such as due to message size constraints), clients
        should make multiple smaller calls or, if that continues to fail, fall
        back to multiple :ref:`org.freedesktop.portal.ProxyResolver.Lookup`
        calls. This may or may not be handled for you if using a library API;
        please see your library's documentation for more information.

        This method was added in version 2 of this interface.
    -->
    <method name="LookupMultiple">
      <arg type="as" name="uris" direction="in"/>
      <arg type="aas" name="proxies" direction="out"/>
    </method>
    <!--
        ProxySettingsChanged:

        Emitted when the system's underlying proxy settings change.

        Clients should use this alongside the
        :ref:`org.freedesktop.portal.ProxyResolver.ProxyMode` property to know
        whether they need to rebuild their proxy caches.

        This signal was added in version 2 of this interface.
    -->
    <signal name="ProxySettingsChanged"></signal>
    <!--
        ProxyMode:

        Indicates the system's preferred reduced proxy usage.
        Supported values are:

        * ``0``: No proxy
        * ``1``: Proxy results not cacheable
        * ``2``: Proxy results cacheable by URL
        * ``3``: Proxy results cacheable by protocol

        for ``3``, URLs with a hostname of localhost, 127.0.0.0/8, or ::1/128
        are exempt should not be proxy resolved; clients should use a direct
        connection rather than cached proxy settings. Clients must still look
        these URLs up with ProxyResolver if the proxy mode is NOT cacheable by
        protocol.

        A client should use the ProxyResolver portal for any value that is not
        ``0``. Clients should treat unknown values as ``1``.

        This property was added in version 2 of this interface.
    -->
    <property name="ProxyMode" type="u" access="read"/>
    <property name="version" type="u" access="read"/>
  </interface>
</node>
