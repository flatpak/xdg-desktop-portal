<node name="/" xmlns:doc="http://www.freedesktop.org/dbus/1.0/doc.dtd">
  <!--
      org.freedesktop.impl.portal.Language:
      @short_description: Local language model backend interface
  -->
  <interface name="org.freedesktop.impl.portal.Language">
    <!--
        GetUseCaseAvailability:
        @app_id: Application ID of the caller
        @use_case: Supported language task token
        @availability: Struct containing is_available, a stable availability status code, and human-readable reason

        Returns whether a local profile is assigned and runnable for @use_case.
        The struct fields are ``is_available``, ``status``, and ``reason``.
        ``is_available`` is authoritative. ``status`` is a stable,
        non-localized value intended for application control flow; defined
        values are ``available``, ``unsupported_use_case``,
        ``permission_denied``, ``no_profile_assigned``,
        ``profile_not_installed``, ``artifact_missing``,
        ``runtime_unsupported``, and ``runtime_missing``. Future versions may
        add values, so callers must tolerate unknown statuses. ``reason`` is
        human-readable diagnostic detail and must not be parsed.
    -->
    <method name="GetUseCaseAvailability">
      <arg type="s" name="app_id" direction="in"/>
      <arg type="s" name="use_case" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="std::tuple&lt;bool,QString,QString&gt;"/>
      <arg type="(bss)" name="availability" direction="out"/>
    </method>

    <!--
        CreateSession:
        @handle: Request handle owned by the frontend
        @session_handle: Session handle allocated by the frontend
        @app_id: Application ID of the caller
        @parent_window: Identifier for the application window, see :doc:`window-identifiers`
        @use_case: Supported language task token
        @instructions: Stable system instructions for this session

        Creates a language model session for @app_id.
    -->
    <method name="CreateSession">
      <arg type="o" name="handle" direction="in"/>
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="s" name="app_id" direction="in"/>
      <arg type="s" name="parent_window" direction="in"/>
      <arg type="s" name="use_case" direction="in"/>
      <arg type="s" name="instructions" direction="in"/>
    </method>

    <!--
        Prewarm:
        @handle: Request handle owned by the frontend
        @session_handle: Language session handle returned by CreateSession

        Optionally starts the container for the session's assigned profile before
        the first user-visible operation. First inference starts the runtime on
        demand if Prewarm is skipped. Prewarm does not prepare a specific stream
        method or request payload.
    -->
    <method name="Prewarm">
      <arg type="o" name="handle" direction="in"/>
      <arg type="o" name="session_handle" direction="in"/>
    </method>

    <!--
        StreamResponse:
        @handle: Request handle owned by the frontend
        @session_handle: Language generation session handle returned by CreateSession
        @input_json: JSON content-part shorthand or role messages to answer
        @media_fds: Unix fds referenced by media content parts
        @options: ``(maximum_response_tokens, temperature, source_language_hint, target_language_hint, execution_mode)``; defaults are ``(512, 0.7, "", "", "interactive")``

        ``input_json`` must be a JSON array. A content-part shorthand array is
        treated as one user message. A role-message array contains objects with
        ``role`` (``system``, ``user``, ``assistant``, or ``tool``) and a
        non-empty ``content`` array. Stream payloads are emitted as
        TokenReceived signals while this call is in progress.
    -->
    <method name="StreamResponse">
      <annotation name="org.gtk.GDBus.C.UnixFD" value="true"/>
      <arg type="o" name="handle" direction="in"/>
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="s" name="input_json" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In3" value="QList&lt;QDBusUnixFileDescriptor&gt;"/>
      <arg type="ah" name="media_fds" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In4" value="std::tuple&lt;qlonglong,double,QString,QString,QString&gt;"/>
      <arg type="(xdsss)" name="options" direction="in"/>
    </method>

    <!--
        StreamRespondGuided:
        @handle: Request handle owned by the frontend
        @session_handle: Language generation session handle returned by CreateSession
        @prompt: Plain text prompt, content-part shorthand JSON, or role-message JSON to answer
        @media_fds: Unix fds referenced by media content parts in @prompt
        @fields: Guided output fields as ``(name, kind, description, required)`` structs
        @tools: Tool definitions as ``(name, description, schema_json)`` structs; ``schema_json`` contains the JSON Schema for tool arguments
        @options: ``(maximum_response_tokens, temperature, execution_mode)``; defaults are ``(512, 0.7, "interactive")``

        Stream payloads are emitted as GuidedSnapshotReceived and/or
        GuidedToolCallsReceived signals while this call is in progress.
    -->
    <method name="StreamRespondGuided">
      <annotation name="org.gtk.GDBus.C.UnixFD" value="true"/>
      <arg type="o" name="handle" direction="in"/>
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="s" name="prompt" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In3" value="QList&lt;QDBusUnixFileDescriptor&gt;"/>
      <arg type="ah" name="media_fds" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In4" value="QList&lt;std::tuple&lt;QString,QString,QString,bool&gt;&gt;"/>
      <arg type="a(sssb)" name="fields" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In5" value="QList&lt;std::tuple&lt;QString,QString,QString&gt;&gt;"/>
      <arg type="a(sss)" name="tools" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In6" value="std::tuple&lt;qlonglong,double,QString&gt;"/>
      <arg type="(xds)" name="options" direction="in"/>
    </method>

    <!--
        StreamSubmitToolResultsGuided:
        @handle: Request handle owned by the frontend
        @session_handle: Language generation session handle returned by CreateSession
        @prompt: Plain text prompt, content-part shorthand JSON, or role-message JSON to answer
        @media_fds: Unix fds referenced by media content parts in @prompt
        @results: Tool results as ``(id, content, content_json)`` structs
        @fields: Guided output fields as ``(name, kind, description, required)`` structs
        @tools: Tool definitions as ``(name, description, schema_json)`` structs; ``schema_json`` contains the JSON Schema for tool arguments
        @options: ``(maximum_response_tokens, temperature, execution_mode)``; defaults are ``(512, 0.7, "interactive")``

        Stream payloads are emitted as GuidedSnapshotReceived and/or
        GuidedToolCallsReceived signals while this call is in progress.
    -->
    <method name="StreamSubmitToolResultsGuided">
      <annotation name="org.gtk.GDBus.C.UnixFD" value="true"/>
      <arg type="o" name="handle" direction="in"/>
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="s" name="prompt" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In3" value="QList&lt;QDBusUnixFileDescriptor&gt;"/>
      <arg type="ah" name="media_fds" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In4" value="QList&lt;std::tuple&lt;QString,QString,QString&gt;&gt;"/>
      <arg type="a(sss)" name="results" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In5" value="QList&lt;std::tuple&lt;QString,QString,QString,bool&gt;&gt;"/>
      <arg type="a(sssb)" name="fields" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In6" value="QList&lt;std::tuple&lt;QString,QString,QString&gt;&gt;"/>
      <arg type="a(sss)" name="tools" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In7" value="std::tuple&lt;qlonglong,double,QString&gt;"/>
      <arg type="(xds)" name="options" direction="in"/>
    </method>

    <!--
        StreamEmbed:
        @handle: Request handle owned by the frontend
        @session_handle: A ``language.embed`` session handle returned by CreateSession
        @text: Text to embed
        @options: ``(execution_mode)``; the default is ``("interactive")``
    -->
    <method name="StreamEmbed">
      <arg type="o" name="handle" direction="in"/>
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="s" name="text" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In3" value="std::tuple&lt;QString&gt;"/>
      <arg type="(s)" name="options" direction="in"/>
    </method>

    <!--
        ModelLoading:
        @handle: Frontend request being prepared
        @session_handle: Language session used by the request
        @message: Human-readable, non-localized progress message

        Emitted while the model or runtime for @handle is being prepared. The
        frontend forwards this signal only to the application that owns the
        request. @message must not be used for control flow.
    -->
    <signal name="ModelLoading">
      <arg type="o" name="handle"/>
      <arg type="o" name="session_handle"/>
      <arg type="s" name="message"/>
    </signal>

    <!--
        TokenReceived:
        @handle: Frontend request that produced this event
        @session_handle: Language session used by the request
        @token: Next text fragment, which may be empty on the terminal event
        @done: Whether this is the terminal stream event for the request

        Emitted in order during StreamResponse. When @done is true, the backend
        must not emit another stream payload signal for @handle.
    -->
    <signal name="TokenReceived">
      <arg type="o" name="handle"/>
      <arg type="o" name="session_handle"/>
      <arg type="s" name="token"/>
      <arg type="b" name="done"/>
    </signal>

    <!--
        GuidedSnapshotReceived:
        @handle: Frontend request that produced this event
        @session_handle: Language session used by the request
        @snapshot_json: Complete JSON object validated against the requested fields
        @done: Whether this is the terminal stream event for the request

        Emitted in order during guided generation. Each @snapshot_json replaces
        the previous snapshot. When @done is true, the backend must not emit
        another stream payload signal for @handle.
    -->
    <signal name="GuidedSnapshotReceived">
      <arg type="o" name="handle"/>
      <arg type="o" name="session_handle"/>
      <arg type="s" name="snapshot_json"/>
      <arg type="b" name="done"/>
    </signal>

    <!--
        GuidedToolCallsReceived:
        @handle: Frontend request that produced this event
        @session_handle: Language session used by the request
        @tool_calls: Tool calls as ``(id, name, arguments_json)`` structs
        @done: Whether this is the terminal stream event for the request

        ``id`` correlates a later tool result, ``name`` identifies a tool
        supplied to the request, and ``arguments_json`` is a JSON object for the
        application to parse and validate. When @done is true, the backend must
        not emit another stream payload signal for @handle.
    -->
    <signal name="GuidedToolCallsReceived">
      <arg type="o" name="handle"/>
      <arg type="o" name="session_handle"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out2" value="QList&lt;std::tuple&lt;QString,QString,QString&gt;&gt;"/>
      <arg type="a(sss)" name="tool_calls"/>
      <arg type="b" name="done"/>
    </signal>

    <!--
        EmbeddingReceived:
        @handle: Frontend request that produced this event
        @session_handle: Language session used by the request
        @embedding: Flat embedding vector
        @embedding_pipeline_id: Compatibility identifier for the embedding pipeline
        @done: Whether this is the terminal stream event for the request

        StreamEmbed emits one event with @done set to true. Vectors are only
        comparable when their @embedding_pipeline_id values match.
    -->
    <signal name="EmbeddingReceived">
      <arg type="o" name="handle"/>
      <arg type="o" name="session_handle"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out2" value="QList&lt;double&gt;"/>
      <arg type="ad" name="embedding"/>
      <arg type="s" name="embedding_pipeline_id"/>
      <arg type="b" name="done"/>
    </signal>

    <property name="version" type="u" access="read"/>
  </interface>
</node>
